# Copia este archivo a .env para desarrollo local. En Railway se configuran como Variables.
PORT=4010
# Sin DATABASE_URL se usa una base local embebida (./.data). En Railway: referencia la variable de tu Postgres.
# DATABASE_URL=postgres://usuario:clave@host:5432/railway
# PGSSL=true   # solo si usas la URL pública de Postgres de Railway
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# Solo desarrollo: login con nombre, sin Google. En producción NO lo definas.
# ALLOW_DEV_LOGIN=true
# Orígenes permitidos (tu dominio de Vercel y localhost), separados por coma. En local puedes usar *
CORS_ORIGINS=http://localhost:5301,https://tu-proyecto.vercel.app
